<section style="background: #FFF0ED; padding: 100px 0;">
  <div style="max-width: 1120px; margin: 0 auto; padding: 0 32px;">
    <div style="display: flex; gap: 80px; align-items: flex-start; flex-wrap: wrap;">

      <!-- LEFT: QUOTE -->
      <div style="flex: 1.1; min-width: 280px;">

        <!-- LABEL -->
        <p style="
          font-family: 'mundial', sans-serif;
          font-weight: 400;
          font-size: 0.75rem;
          letter-spacing: 0.03em;
          line-height: 1.5;
          text-transform: uppercase;
          color: #286B77;
          margin: 0 0 20px 0;
        ">{{ section.settings.eyebrow }}</p>

        <!-- BLOCKQUOTE: kepler-std italic, 48px, line-height 100% -->
        <blockquote style="
          font-family: 'kepler-std', serif;
          font-style: italic;
          font-weight: 500;
          font-size: clamp(1.5rem, 3vw, 2rem);
          line-height: 1.45;
          letter-spacing: 0;
          color: #000000;
          border-left: 3px solid #286B77;
          padding-left: 28px;
          margin: 0;
        ">
          {{ section.settings.quote }}

          <!-- CLIENT NAME: label style -->
          <span style="
            display: block;
            margin-top: 20px;
            font-family: 'mundial', sans-serif;
            font-style: normal;
            font-weight: 400;
            font-size: 0.75rem;
            letter-spacing: 0.03em;
            line-height: 1.5;
            text-transform: uppercase;
            color: #286B77;
          ">{{ section.settings.client_name }}</span>
        </blockquote>

      </div>

      <!-- RIGHT: STATS -->
      <div style="flex: 0.9; min-width: 240px; display: flex; gap: 40px;">

        <!-- STAT 1 -->
        <div style="flex: 1;">
          <div style="
            font-family: 'mundial', sans-serif;
            font-weight: 400;
            font-size: clamp(2rem, 4vw, 2.75rem);
            line-height: 1;
            letter-spacing: 0;
            color: #286B77;
            margin-bottom: 10px;
          ">{{ section.settings.stat_1_number }}</div>

          <p style="
            font-family: 'mundial', sans-serif;
            font-weight: 400;
            font-size: 0.875rem;
            line-height: 1.5;
            letter-spacing: 0;
            color: #000000;
            margin: 0 0 8px 0;
          ">{{ section.settings.stat_1_label }}</p>

          <p style="
            font-family: 'mundial', sans-serif;
            font-weight: 600;
            font-size: 0.625rem;
            letter-spacing: 0.03em;
            line-height: 1.5;
            text-transform: uppercase;
            color: #000000;
            margin: 0;
          ">{{ section.settings.stat_1_source }}</p>
        </div>

        <!-- STAT 2 -->
        <div style="flex: 1;">
          <div style="
            font-family: 'mundial', sans-serif;
            font-weight: 400;
            font-size: clamp(2rem, 4vw, 2.75rem);
            line-height: 1;
            letter-spacing: 0;
            color: #286B77;
            margin-bottom: 10px;
          ">{{ section.settings.stat_2_number }}</div>

          <p style="
            font-family: 'mundial', sans-serif;
            font-weight: 400;
            font-size: 0.875rem;
            line-height: 1.5;
            letter-spacing: 0;
            color: #000000;
            margin: 0 0 8px 0;
          ">{{ section.settings.stat_2_label }}</p>

          <p style="
            font-family: 'mundial', sans-serif;
            font-weight: 600;
            font-size: 0.625rem;
            letter-spacing: 0.03em;
            line-height: 1.5;
            text-transform: uppercase;
            color: #000000;
            margin: 0;
          ">{{ section.settings.stat_2_source }}</p>
        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Proof — Moments",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "Proof"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "McCarthy Tétrault runs a full moments program across their client relationships — birthdays, retirements, celebrations, seasonal touchpoints — because loyalty shouldn't depend on whoever remembers to send a card."
    },
    {
      "type": "text",
      "id": "client_name",
      "label": "Client Name",
      "default": "McCarthy Tétrault"
    },
    {
      "type": "text",
      "id": "stat_1_number",
      "label": "Stat 1 Number",
      "default": "306%"
    },
    {
      "type": "textarea",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "higher lifetime value for customers with an emotional connection to a brand"
    },
    {
      "type": "text",
      "id": "stat_1_source",
      "label": "Stat 1 Source",
      "default": "Accenture"
    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Stat 2 Number",
      "default": "95%"
    },
    {
      "type": "textarea",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "increase in profit from just a 5% increase in retention"
    },
    {
      "type": "text",
      "id": "stat_2_source",
      "label": "Stat 2 Source",
      "default": "Harvard Business Review"
    }
  ],
  "presets": [
    {
      "name": "Proof — Moments"
    }
  ]
}
{% endschema %}