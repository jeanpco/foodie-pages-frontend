<section style="background: #286B77; padding: 150px 0 110px; position: relative; overflow: hidden;">

  <!-- DECORATIVE CIRCLE -->
  <div style="
    position: absolute;
    right: -80px;
    bottom: -140px;
    width: 520px;
    height: 520px;
    border: 1px solid rgba(255,247,242,0.15);
    border-radius: 50%;
    pointer-events: none;
  "></div>
  <div style="
    position: absolute;
    right: -20px;
    bottom: -80px;
    width: 400px;
    height: 400px;
    border: 1px solid rgba(255,247,242,0.10);
    border-radius: 50%;
    pointer-events: none;
  "></div>

  <div style="max-width: 1120px; margin: 0 auto; padding: 0 32px;">

    <!-- EYEBROW LABEL -->
    <p style="
      font-family: 'mundial', sans-serif;
      font-weight: 400;
      font-size: 0.75rem;
      letter-spacing: 0.03em;
      line-height: 1.5;
      text-transform: uppercase;
      color: #BFE3E6;
      margin: 0 0 22px 0;
    ">{{ section.settings.eyebrow }}</p>

    <!-- H1: mundial regular, 64px desktop -->
    <h1 style="
      font-family: 'mundial', sans-serif;
      font-weight: 400;
      font-size: clamp(2.5rem, 6vw, 4rem);
      line-height: 1.0;
      letter-spacing: 0;
      color: #FFFFFF;
      margin: 0 0 20px 0;
      max-width: 820px;
    ">{{ section.settings.headline }}</h1>

    <!-- SUBHEAD: kepler-std italic -->
    <p style="
      font-family: 'mundial', sans-serif;
      font-weight: 500;
      font-size: clamp(1.125rem, 2vw, 1.375rem);
      line-height: 1.4;
      letter-spacing: 0;
      color: #CFE9EB;
      max-width: 620px;
      margin: 0 0 44px 0;
    ">{{ section.settings.subhead }}</p>

    <!-- CTA BUTTON -->
    <a href="{{ section.settings.button_url }}" style="
      display: inline-block;
      background: #FFF7F2;
      color: #15414B;
      font-family: 'mundial', sans-serif;
      font-weight: 600;
      font-size: 0.9375rem;
      line-height: 1;
      letter-spacing: 0;
      text-decoration: none;
      padding: 16px 32px;
      border-radius: 2px;
    ">{{ section.settings.button_label }}</a>

  </div>
</section>

{% schema %}
{
  "name": "Hero — Strengthen",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "Program 02 — For Existing Clients"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Strengthen the relationship."
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subheadline",
      "default": "Deepen loyalty beyond the transaction."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Text",
      "default": "Book a Relationship Architecture Session"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Hero — Strengthen"
    }
  ]
}
{% endschema %}