<section style="background: #FFF7F2; padding: 100px 0;">
  <div style="max-width: 900px; margin: 0 auto; padding: 0 32px;">

    <!-- LABEL: mundial regular, 12pt (16px), letter-spacing 3%, line-height 150%, uppercase -->
    <p style="
      font-family: 'mundial', sans-serif;
      font-weight: 400;
      font-size: 0.75rem;
      letter-spacing: 0.03em;
      line-height: 1.5;
      text-transform: uppercase;
      color: #286B77;
      margin-bottom: 18px;
    ">{{ section.settings.eyebrow }}</p>

    <!-- H2: mundial regular, 48pt (3rem desktop / 2.5rem tablet / 2rem mobile), line-height 120%, letter-spacing 0 -->
    <h2 style="
      font-family: 'mundial', sans-serif;
      font-weight: 400;
      font-size: clamp(2rem, 4vw, 3rem);
      line-height: 1.2;
      letter-spacing: 0;
      color: #000000;
      margin-bottom: 36px;
    ">
      {{ section.settings.headline_regular }}
      <span style="color: #286B77;">{{ section.settings.headline_accent }}</span>
    </h2>

    <!-- DIVIDER -->
    <div style="height: 1px; background: #D9CFC4; margin-bottom: 36px;"></div>

    <!-- BODY: mundial light, 18pt (body large), letter-spacing 0, line-height 140% -->
    <p style="
      font-family: 'mundial', sans-serif;
      font-weight: 400;
      font-size: 1rem;
      line-height: 1.5;
      letter-spacing: 0;
      color: #000000;
      max-width: 760px;
    ">{{ section.settings.body_text }}</p>

  </div>
</section>

{% schema %}
{
  "name": "The Shift",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "The Shift"
    },
    {
      "type": "text",
      "id": "headline_regular",
      "label": "Headline — Regular Text",
      "default": "Most companies invest everything in winning the client."
    },
    {
      "type": "text",
      "id": "headline_accent",
      "label": "Headline — Accent Text (teal)",
      "default": "Very little is designed for what happens after."
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body Text",
      "default": "Your best clients are already being approached by competitors promising to do it cheaper, faster, or better. The companies that stay genuinely close between transactions are harder to replace — and harder to pitch against. Loyalty isn't built in the winning. It's built in the staying."
    }
  ],
  "presets": [
    {
      "name": "The Shift"
    }
  ]
}
{% endschema %}